<UserControl x:Class="GVK.GridDefender.Views.GridDefenderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="750">
    <UserControl.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="5,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="4" Padding="15" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="🛡️ GVK GridDefender" FontSize="20" FontWeight="Bold" Foreground="#4CAF50" VerticalAlignment="Center"/>
                    <TextBlock Text="v2.0 (Missile, Anti-Ramming, Anti-Clang &amp; Push-Apart)" FontSize="12" Foreground="#888888" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button Content="Save Configuration" Click="SaveButton_OnClick" DockPanel.Dock="Right" Background="#2E7D32" Foreground="White" BorderThickness="0"/>
            </DockPanel>
        </Border>

        <!-- Main Content Tabs -->
        <TabControl Grid.Row="1" Background="#252526" BorderBrush="#333333">
            <!-- Settings Tab -->
            <TabItem Header="Configuration">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <!-- Quick Overview Banner -->
                        <Border Background="#1F2937" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="💡 How GridDefender Works:" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,4"/>
                                <TextBlock Text="• 🚀 Missiles (PMWs): Grids matching missile block counts &amp; min speed WILL deal full impact damage." Foreground="#D1D5DB" TextWrapping="Wrap"/>
                                <TextBlock Text="• 🛡️ Ships &amp; Rovers: Grids larger than missiles are PROTECTED from crash, ramming, and driving damage." Foreground="#D1D5DB" TextWrapping="Wrap"/>
                                <TextBlock Text="• ⚡ Anti-Clang: Automatically absorbs kinetic energy and stops continuous vibration/phasing loops." Foreground="#D1D5DB" TextWrapping="Wrap"/>
                                <TextBlock Text="• 🧲 Push-Apart: Automatically separates grids if they get stuck or phase inside terrain/each other." Foreground="#D1D5DB" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- General Settings -->
                        <GroupBox Header="General Settings">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" Grid.ColumnSpan="2" Content="Enable GridDefender Protection" IsChecked="{Binding Config.Enabled}" FontWeight="Bold"/>
                                <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Content="Enable Debug Logging (Log missile hits, anti-clang &amp; push-apart to Torch console)" IsChecked="{Binding Config.EnableDebugLogging}"/>
                                
                                <Label Grid.Row="2" Grid.Column="0" Content="Allowed Damage Multiplier (0.0 to 1.0):"/>
                                <Grid Grid.Row="2" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="0.0" Maximum="1.0" Value="{Binding Config.DeformationMultiplier}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" Margin="5"/>
                                    <TextBox Grid.Column="1" Text="{Binding Config.DeformationMultiplier, StringFormat={}{0:F2}}" Width="50" HorizontalContentAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </GroupBox>

                        <!-- Anti-Clang & Phasing Prevention -->
                        <GroupBox Header="⚡ Anti-Clang &amp; Phasing Prevention">
                            <StackPanel>
                                <TextBlock Text="Prevents non-deforming grids from phasing into terrain/each other and stops violent physics vibration loops." Foreground="#9CA3AF" FontSize="11" Margin="5,0,0,8"/>
                                <CheckBox Content="Enable Anti-Clang &amp; Kinetic Absorption System" IsChecked="{Binding Config.EnableAntiClang}" FontWeight="SemiBold"/>
                                <CheckBox Content="Stop Clang Death Spins (Zero out extreme rotational velocity)" IsChecked="{Binding Config.StopClangSpinning}"/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Impact Velocity Damping (0.0 to 1.0):"/>
                                    <Grid Grid.Row="0" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0.0" Maximum="1.0" Value="{Binding Config.ImpactVelocityDamping}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" Margin="5"/>
                                        <TextBox Grid.Column="1" Text="{Binding Config.ImpactVelocityDamping, StringFormat={}{0:F2}}" Width="50" HorizontalContentAlignment="Center"/>
                                    </Grid>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Continuous Contact Threshold (Frames):"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.AntiClangVibrationThreshold}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- Active Push-Apart / Separation -->
                        <GroupBox Header="🧲 Active Push-Apart (Anti-Stuck Separation)">
                            <StackPanel>
                                <TextBlock Text="Gently nudges overlapping grids apart if they remain persistently stuck or phased together." Foreground="#9CA3AF" FontSize="11" Margin="5,0,0,8"/>
                                <CheckBox Content="Enable Active Push-Apart Separation" IsChecked="{Binding Config.EnablePushApart}" FontWeight="SemiBold"/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Push-Apart Threshold (Frames):"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.PushApartThreshold}"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Push-Apart Distance (Meters):"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.PushApartDistance, StringFormat={}{0:F2}}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- Missile (PMW) Settings -->
                        <GroupBox Header="🚀 Missile (PMW) Allowance Settings">
                            <StackPanel>
                                <TextBlock Text="Grids within these block limits and moving faster than min velocity are recognized as missiles and deal damage." Foreground="#9CA3AF" FontSize="11" Margin="5,0,0,8"/>
                                <CheckBox Content="Allow Player-Made Missile (PMW) Impact Damage" IsChecked="{Binding Config.AllowMissileDamage}" FontWeight="SemiBold" Margin="5,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Large Missile Min Blocks:"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.LargeGridMissileMinBlocks}"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Large Missile Max Blocks:"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.LargeGridMissileMaxBlocks}"/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="Small Missile Min Blocks:"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.SmallGridMissileMinBlocks}"/>

                                    <Label Grid.Row="3" Grid.Column="0" Content="Small Missile Max Blocks:"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.SmallGridMissileMaxBlocks}"/>

                                    <Label Grid.Row="4" Grid.Column="0" Content="Missile Min Velocity (m/s):"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Config.MissileMinVelocity, StringFormat={}{0:F1}}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- Ship & Rover Protection -->
                        <GroupBox Header="🛡️ Ship &amp; Rover Ramming &amp; Driving Protection">
                            <StackPanel>
                                <TextBlock Text="Grids larger than missiles are protected against accidental terrain collisions and ship-to-ship ramming." Foreground="#9CA3AF" FontSize="11" Margin="5,0,0,8"/>
                                <CheckBox Content="Protect Ships From Ship-on-Ship Ramming" IsChecked="{Binding Config.ProtectShipsAgainstRamming}"/>
                                <CheckBox Content="Protect Ships &amp; Rovers From Voxel (Planet/Asteroid) Crashes" IsChecked="{Binding Config.ProtectShipsAgainstVoxels}"/>
                                <CheckBox Content="Protect Against Floating Objects / Debris / Ores" IsChecked="{Binding Config.ProtectAgainstFloatingObjects}"/>
                                <CheckBox Content="Protect Static Grids (Stations) From Ramming" IsChecked="{Binding Config.ProtectStaticGrids}"/>
                                <CheckBox Content="Protect Subgrids / Mechanicals (Pistons, Rotors, Hinges) from Clang" IsChecked="{Binding Config.ProtectSubgrids}"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Thresholds & Performance -->
                        <GroupBox Header="⚙️ Safety Thresholds &amp; Cooldown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Min Driving Velocity (m/s, Safe Docking):"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.MinDrivingVelocity, StringFormat={}{0:F1}}"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="Max Velocity Limit (m/s, Anti-Crash):"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.MaxDeformationVelocity, StringFormat={}{0:F1}}"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="Deformation Cooldown (Frames):"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.DeformationCooldownFrames}"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Statistics Tab -->
            <TabItem Header="Live Telemetry">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Real-Time Collision Telemetry &amp; Missile Hits" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="1">
                        <Border Background="#1A1A1A" CornerRadius="4" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="Total Evaluated" Foreground="#888888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Statistics.TotalEvaluated, StringFormat={}{0:N0}}" FontSize="20" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="Crashes Blocked" Foreground="#888888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Statistics.TotalBlocked, StringFormat={}{0:N0}}" FontSize="20" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="Block Ratio" Foreground="#888888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Statistics.BlockRatio, StringFormat={}{0:F1}%}" FontSize="20" FontWeight="Bold" Foreground="#FF9800" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <TextBlock Text="🚀 Missile Hits" Foreground="#888888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Statistics.MissileHitsAllowed, StringFormat={}{0:N0}}" FontSize="20" FontWeight="Bold" Foreground="#E91E63" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <GroupBox Header="Detailed Breakdown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="🚀 Missile Impacts Allowed:"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Statistics.MissileHitsAllowed, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E91E63"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="⚡ Clang Vibrations Arrested:"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Statistics.ClangVibrationsArrested, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFEB3B"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="🧲 Grids Separated (Push-Apart):"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Statistics.GridsSeparated, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#00E676"/>

                                <Label Grid.Row="3" Grid.Column="0" Content="🛡️ Ship Ramming Blocked:"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Statistics.RammingBlocked, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#CCCCCC"/>

                                <Label Grid.Row="4" Grid.Column="0" Content="🏔️ Voxel Crashes Blocked:"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Statistics.VoxelCrashesBlocked, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#CCCCCC"/>

                                <Label Grid.Row="5" Grid.Column="0" Content="⚙️ Subgrid Collisions Blocked:"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Statistics.SubgridCollisionsBlocked, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#CCCCCC"/>

                                <Label Grid.Row="6" Grid.Column="0" Content="⏱️ Cooldown Throttled:"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Statistics.CooldownThrottled, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#CCCCCC"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>

                    <Button Grid.Row="2" Content="Reset Telemetry Counters" Click="ResetStatsButton_OnClick" HorizontalAlignment="Left" Background="#C62828" Foreground="White" BorderThickness="0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

