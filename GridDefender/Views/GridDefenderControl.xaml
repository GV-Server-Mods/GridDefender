<UserControl x:Class="GVK.GridDefender.Views.GridDefenderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="750">
    <UserControl.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="5,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="380"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#007ACC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Title & Subtitle -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,20,4">
                    <TextBlock Text="🛡️ GVK GridDefender" FontSize="18" FontWeight="Bold" Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="(Missile, Anti-Ramming, Anti-Clang &amp; Push-Apart)" FontSize="12" Foreground="#888888" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </WrapPanel>

                <!-- Status & Action Button -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                    <TextBlock Text="Changes auto-apply immediately" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Save to Disk" Click="SaveButton_OnClick" Background="#2E7D32" Foreground="White" BorderThickness="0" ToolTip="Force immediate save of configuration to disk."/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Main Content Tabs -->
        <TabControl Grid.Row="1" Background="#252526" BorderBrush="#333333">
            <!-- Settings Tab -->
            <TabItem Header="Configuration">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <!-- Quick Overview Banner -->
                        <Border Background="#1F2937" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="💡 How GridDefender Works (Zero-Cost Damage Short-Circuit):" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,4"/>
                                <TextBlock Text="• ⚡ Prefix Interception: Hooks Keen's internal MyGridPhysics.PerformDeformation BEFORE expensive bone deformation, block health math, and mesh recalculations run. Non-missiles abort in ~0.002ms." Foreground="#D1D5DB" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                <TextBlock Text="• 🚀 Missiles (PMWs): Valid missiles bypass the block, executing 100% full vanilla deformation &amp; kinetic damage. Spent remnants auto-transition to Anti-Clang." Foreground="#D1D5DB" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                <TextBlock Text="• 🛡️ Ships &amp; Rovers: Grids larger than missiles skip deformation entirely—ships bounce with natural Havok momentum without CPU lag spikes or armor crumpling." Foreground="#D1D5DB" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                <TextBlock Text="• 🏔️ Voxel Preservation: Blocks all collision gouges &amp; explosion craters across the server. Hand &amp; ship drill mining remains 100% functional." Foreground="#D1D5DB" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                <TextBlock Text="• 🧲 Anti-Clang &amp; Push-Apart: Dampens continuous contact vibration loops and nudges stuck grids apart to preserve 60 TPS." Foreground="#D1D5DB" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- General Settings -->
                        <GroupBox Header="General Settings">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" Grid.ColumnSpan="2" Content="Enable GridDefender Protection" IsChecked="{Binding Config.Enabled}" FontWeight="Bold"
                                          ToolTip="Master toggle for Grid Defender collision protection, anti-clang damping, and grid separation."/>
                                <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Content="Enable Debug Logging (Log missile hits, anti-clang &amp; push-apart to Torch console)" IsChecked="{Binding Config.EnableDebugLogging}"
                                          ToolTip="Logs missile hits, anti-clang damping, and push-apart actions to the Torch console."/>
                                
                                <Label Grid.Row="2" Grid.Column="0" Content="Allowed Impact Damage Multiplier (0.0 to 1.0):"
                                       ToolTip="Damage multiplier when impact damage is permitted (e.g., missiles). 1.0 = full damage, 0.0 = zero damage."/>
                                <Grid Grid.Row="2" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="0.0" Maximum="1.0" Value="{Binding Config.DeformationMultiplier}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" Margin="5"
                                            ToolTip="Damage multiplier when impact damage is permitted (e.g., missiles). 1.0 = full damage, 0.0 = zero damage."/>
                                    <TextBox Grid.Column="1" Text="{Binding Config.DeformationMultiplier, StringFormat={}{0:F2}}" Width="50" HorizontalContentAlignment="Center"
                                             ToolTip="Damage multiplier when impact damage is permitted (e.g., missiles). 1.0 = full damage, 0.0 = zero damage."/>
                                </Grid>
                            </Grid>
                        </GroupBox>

                        <!-- Anti-Clang & Phasing Prevention -->
                        <GroupBox Header="⚡ Anti-Clang &amp; Phasing Prevention">
                            <StackPanel>
                                <TextBlock Text="Prevents non-damaging colliding grids from phasing into terrain/each other and stops violent physics vibration loops." Foreground="#9CA3AF" FontSize="11" Margin="5,0,0,8"/>
                                <CheckBox Content="Enable Anti-Clang &amp; Kinetic Absorption System" IsChecked="{Binding Config.EnableAntiClang}" FontWeight="SemiBold"
                                          ToolTip="Absorbs excess kinetic energy on non-damaging collisions to prevent voxel phasing, rubberbanding, and Havok physics loops."/>
                                <CheckBox Content="Stop Clang Death Spins (Zero out extreme rotational velocity)" IsChecked="{Binding Config.StopClangSpinning}"
                                          ToolTip="Instantly zeros out extreme rotational spin (> 5 rad/s) caused by Havok subgrid glitches before grids rip apart."/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Impact Velocity Damping (0.0 to 1.0):"
                                           ToolTip="Velocity absorbed on protected collisions (0.0 = full bounce, 0.5 = 50% absorbed, 1.0 = dead stop). Stops terrain tunneling."/>
                                    <Grid Grid.Row="0" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0.0" Maximum="1.0" Value="{Binding Config.ImpactVelocityDamping}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" Margin="5"
                                                ToolTip="Velocity absorbed on protected collisions (0.0 = full bounce, 0.5 = 50% absorbed, 1.0 = dead stop). Stops terrain tunneling."/>
                                        <TextBox Grid.Column="1" Text="{Binding Config.ImpactVelocityDamping, StringFormat={}{0:F2}}" Width="50" HorizontalContentAlignment="Center"
                                                 ToolTip="Velocity absorbed on protected collisions (0.0 = full bounce, 0.5 = 50% absorbed, 1.0 = dead stop). Stops terrain tunneling."/>
                                    </Grid>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Continuous Contact Threshold (Frames):"
                                           ToolTip="Consecutive collision frames before aggressive damping engages to stop physics vibrations and grinding."/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.AntiClangVibrationThreshold}"
                                             ToolTip="Consecutive collision frames before aggressive damping engages to stop physics vibrations and grinding."/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- Active Push-Apart / Separation -->
                        <GroupBox Header="🧲 Active Push-Apart (Anti-Stuck Separation)">
                            <StackPanel>
                                <TextBlock Text="Gently nudges overlapping grids apart if they remain persistently stuck or phased together." Foreground="#9CA3AF" FontSize="11" Margin="5,0,0,8"/>
                                <CheckBox Content="Enable Active Push-Apart Separation" IsChecked="{Binding Config.EnablePushApart}" FontWeight="SemiBold"
                                          ToolTip="Gently translates grids apart if they remain stuck or phased together in continuous contact."/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Push-Apart Threshold (Frames):"
                                           ToolTip="Consecutive collision frames (~25 frames = 0.4s) required before triggering separation."/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.PushApartThreshold}"
                                             ToolTip="Consecutive collision frames (~25 frames = 0.4s) required before triggering separation."/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Push-Apart Distance (Meters):"
                                           ToolTip="Distance in meters (0.2 to 2.0m) to gently nudge stuck grids apart along the contact normal."/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.PushApartDistance, StringFormat={}{0:F2}}"
                                             ToolTip="Distance in meters (0.2 to 2.0m) to gently nudge stuck grids apart along the contact normal."/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- Missile (PMW) Settings -->
                        <GroupBox Header="🚀 Missile (PMW) Allowance Settings">
                            <StackPanel>
                                <TextBlock Text="Grids within these block limits and moving faster than min velocity are recognized as missiles and deal impact damage." Foreground="#9CA3AF" FontSize="11" Margin="5,0,0,8"/>
                                <CheckBox Content="Allow Player-Made Missile (PMW) Impact Damage" IsChecked="{Binding Config.AllowMissileDamage}" FontWeight="SemiBold" Margin="5,0,0,8"
                                          ToolTip="Allows recognized player-made missiles to deal full impact damage when striking targets."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Large Missile Min Blocks:"
                                           ToolTip="Minimum block count for a large grid missile. Filters out loose debris or single blocks."/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.LargeGridMissileMinBlocks}"
                                             ToolTip="Minimum block count for a large grid missile. Filters out loose debris or single blocks."/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Large Missile Max Blocks:"
                                           ToolTip="Maximum block count for a large grid missile. Grids above this count are protected as ships."/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.LargeGridMissileMaxBlocks}"
                                             ToolTip="Maximum block count for a large grid missile. Grids above this count are protected as ships."/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="Small Missile Min Blocks:"
                                           ToolTip="Minimum block count for a small grid missile. Default: 4 blocks."/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.SmallGridMissileMinBlocks}"
                                             ToolTip="Minimum block count for a small grid missile. Default: 4 blocks."/>

                                    <Label Grid.Row="3" Grid.Column="0" Content="Small Missile Max Blocks:"
                                           ToolTip="Maximum block count for a small grid missile. Grids above this count are protected as ships/rovers."/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.SmallGridMissileMaxBlocks}"
                                             ToolTip="Maximum block count for a small grid missile. Grids above this count are protected as ships/rovers."/>

                                    <Label Grid.Row="4" Grid.Column="0" Content="Missile Min Velocity (m/s):"
                                           ToolTip="Minimum impact velocity (m/s) required for a missile to deal damage. Slower bumps deal no damage."/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Config.MissileMinVelocity, StringFormat={}{0:F1}}"
                                             ToolTip="Minimum impact velocity (m/s) required for a missile to deal damage. Slower bumps deal no damage."/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- Ship & Rover Protection -->
                        <GroupBox Header="🛡️ Ship &amp; Rover Ramming &amp; Driving Protection">
                            <StackPanel>
                                <TextBlock Text="Grids larger than missiles are protected against accidental terrain collisions and ship-to-ship ramming." Foreground="#9CA3AF" FontSize="11" Margin="5,0,0,8"/>
                                <CheckBox Content="Protect Ships From Ship-on-Ship Ramming" IsChecked="{Binding Config.ProtectShipsAgainstRamming}"
                                          ToolTip="Blocks impact damage when full-sized ships or rovers collide with each other, preventing grief ramming."/>
                                <CheckBox Content="Protect Ships &amp; Rovers From Voxel (Planet/Asteroid) Crashes" IsChecked="{Binding Config.ProtectShipsAgainstVoxels}"
                                          ToolTip="Blocks impact damage when rovers or ships hit terrain, dunes, or asteroids. Keeps rovers driving smoothly."/>
                                <CheckBox Content="Protect Against Floating Objects / Debris / Ores" IsChecked="{Binding Config.ProtectAgainstFloatingObjects}"
                                          ToolTip="Suppresses impact damage from floating ores, dropped items, and detached debris."/>
                                <CheckBox Content="Protect Static Grids (Stations) From Ramming" IsChecked="{Binding Config.ProtectStaticGrids}"
                                          ToolTip="Suppresses impact damage on stations and anchored static structures when rammed."/>
                                <CheckBox Content="Protect Subgrids / Mechanicals (Pistons, Rotors, Hinges) from Clang" IsChecked="{Binding Config.ProtectSubgrids}"
                                          ToolTip="Suppresses self-collision damage between subgrids (rotors, hinges, pistons) to stop Clang chain reactions."/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Voxel & Terrain Protection -->
                        <GroupBox Header="🏔️ Voxel &amp; Terrain Protection">
                            <StackPanel>
                                <TextBlock Text="Universal terrain preservation: Stops explosive &amp; collision craters from gouging roads while preserving mining." Foreground="#9CA3AF" FontSize="11" Margin="5,0,0,8"/>
                                <CheckBox Content="Suppress Explosion &amp; Crash Voxel Cutouts" IsChecked="{Binding Config.SuppressAllVoxelExplosionDamage}" FontWeight="SemiBold"
                                          ToolTip="Disables voxel crater cutouts from explosions, warheads, weapons, and crashes. Drill mining (hand &amp; ship drills) remains 100% operational!"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Thresholds & Speed Gates -->
                        <GroupBox Header="⚙️ Fallback Speed Gates &amp; Rate Limits">
                            <StackPanel>
                                <Border Background="#1E293B" BorderBrush="#475569" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                    <TextBlock Text="ℹ️ Fallback Safety Net: These thresholds (docking safe-harbor, extreme-speed lag cap, and damage cooldown) only apply if Ship Ramming, Voxel, or Station protection is unchecked above. When all three protections are checked, full collision immunity is active and these thresholds are bypassed." 
                                               Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
                                </Border>
                                <Grid IsEnabled="{Binding Config.IsSpeedGatesApplicable}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Min Driving Velocity (m/s, Safe Harbor):"
                                           ToolTip="Fallback: Collisions below this speed never deal damage when ramming or voxel protection is disabled."/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.MinDrivingVelocity, StringFormat={}{0:F1}}"
                                             ToolTip="Fallback: Collisions below this speed never deal damage when ramming or voxel protection is disabled."/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Max Velocity Limit (m/s, Anti-Crash):"
                                           ToolTip="Fallback: Extreme-speed collisions above this speed skip damage processing to prevent server lag freezes when ramming is allowed."/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.MaxDeformationVelocity, StringFormat={}{0:F1}}"
                                             ToolTip="Fallback: Extreme-speed collisions above this speed skip damage processing to prevent server lag freezes when ramming is allowed."/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="Impact Damage Cooldown (Frames):"
                                           ToolTip="Fallback: Simulation frames between damage evaluations per grid during continuous contact when damage is permitted."/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.DeformationCooldownFrames}"
                                             ToolTip="Fallback: Simulation frames between damage evaluations per grid during continuous contact when damage is permitted."/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Statistics Tab -->
            <TabItem Header="Live Telemetry">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Real-Time Collision Telemetry &amp; Missile Hits" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="1">
                        <Border Background="#1A1A1A" CornerRadius="4" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="Total Evaluated" Foreground="#888888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Statistics.TotalEvaluated, StringFormat={}{0:N0}}" FontSize="20" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="Crashes Blocked" Foreground="#888888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Statistics.TotalBlocked, StringFormat={}{0:N0}}" FontSize="20" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="Block Ratio" Foreground="#888888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Statistics.BlockRatio, StringFormat={}{0:F1}%}" FontSize="20" FontWeight="Bold" Foreground="#FF9800" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <TextBlock Text="🚀 Missile Hits" Foreground="#888888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Statistics.MissileHitsAllowed, StringFormat={}{0:N0}}" FontSize="20" FontWeight="Bold" Foreground="#E91E63" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <GroupBox Header="Detailed Breakdown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="🚀 Missile Impacts Allowed:"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Statistics.MissileHitsAllowed, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E91E63"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="⚡ Clang Vibrations Arrested:"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Statistics.ClangVibrationsArrested, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFEB3B"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="🧲 Grids Separated (Push-Apart):"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Statistics.GridsSeparated, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#00E676"/>

                                <Label Grid.Row="3" Grid.Column="0" Content="🛡️ Ship Ramming Blocked:"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Statistics.RammingBlocked, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#CCCCCC"/>

                                <Label Grid.Row="4" Grid.Column="0" Content="🏔️ Voxel Crashes Blocked:"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Statistics.VoxelCrashesBlocked, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#CCCCCC"/>

                                <Label Grid.Row="5" Grid.Column="0" Content="⚙️ Subgrid Collisions Blocked:"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Statistics.SubgridCollisionsBlocked, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#CCCCCC"/>

                                <Label Grid.Row="6" Grid.Column="0" Content="⚓ Safe Docking / Low Speed (&lt; 5m/s):"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Statistics.LowSpeedBlocked, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#CCCCCC"/>

                                <Label Grid.Row="7" Grid.Column="0" Content="🏛️ Station Crashes Blocked:"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Statistics.StationBlocked, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#CCCCCC"/>

                                <Label Grid.Row="8" Grid.Column="0" Content="📦 Debris &amp; Floating Objects:"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Statistics.DebrisBlocked, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#CCCCCC"/>

                                <Label Grid.Row="9" Grid.Column="0" Content="⏱️ Cooldown Throttled:"/>
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Statistics.CooldownThrottled, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#CCCCCC"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>

                    <Button Grid.Row="2" Content="Reset Telemetry Counters" Click="ResetStatsButton_OnClick" HorizontalAlignment="Left" Background="#C62828" Foreground="White" BorderThickness="0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

